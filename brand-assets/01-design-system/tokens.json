{
  "version": "2026-10-09",
  "grid": {
    "columns": 6,
    "mobile_span": 6,
    "desktop_span": 3,
    "ultrawide_span": 2,
    "gutter": "clamp(12px,1.5vw,30px)"
  },
  "sites": 3,
  "sections_per_site": 5,
  "layers_per_section": 3,
  "golden_ratio": 1.61803398875,
  "typography": {
    "family": "Inter, system-ui, sans-serif",
    "body_px": 16,
    "headings": "same size, heavier weight",
    "underline": "links only",
    "bold": "headers and active only",
    "italics": "rare emphasis only"
  },
  "colors": {
    "B2W": {
      "accent": "#EF772C",
      "ink": "#191919",
      "paper": "#F7F4EF",
      "soft": "#FFF0E2"
    },
    "JasonAI": {
      "accent": "#267C58",
      "ink": "#143D2C",
      "paper": "#F5F8F4",
      "soft": "#E2F1E7"
    },
    "Clara": {
      "accent": "#8560A7",
      "ink": "#2C1A44",
      "paper": "#FAF8FC",
      "soft": "#F1EAF7"
    }
  },
  "image_filters": {
    "B2W": "saturate(.78) contrast(1.08) sepia(.11)",
    "JasonAI": "saturate(.76) contrast(1.07) hue-rotate(-7deg)",
    "Clara": "saturate(.70) contrast(1.08) hue-rotate(3deg)"
  },
  "motion": {
    "entrance_ms": 300,
    "action_ms": 200,
    "state_transition_ms": 650,
    "easing": "cubic-bezier(.2,.72,.2,1)",
    "reduced_motion": "always render static final state"
  },
  "review_policy": "Generated concepts require visual approval; no production page layout or existing logo may be overwritten."
}
